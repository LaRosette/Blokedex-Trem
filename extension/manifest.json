{
  "manifest_version": 3,
  "name": "Blokedex-Trem",
  "version": "3.0.0",
  "description": "Masquez localement les publications des comptes de la liste, sans les bloquer sur X.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "alarms"],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self' https://raw.githubusercontent.com/LaRosette/Blokedex-Trem/main/liste/accounts.json https://raw.githubusercontent.com/LaRosette/Blokedex-Trem/main/updates/latest.json; object-src 'none'; base-uri 'none'; form-action 'none'"
  },
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Blokedex-Trem",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "run_at": "document_start",
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["filter-core.js", "content.js"],
      "css": ["filter.css"]
    }
  ]
}
